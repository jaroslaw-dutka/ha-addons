{
  "name": "Assist Satellite for XVF3800",
  "url": "https://github.com/imonlinux/linux-voice-assistant",
  "version": "1.0.0",
  "description": "Turn HA host into a voice assistant with a connected ReSpeaker XVF3800",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "slug": "assist-satellite-xvf3800",
  "startup": "application",
  "boot": "auto",
  "init": false,
  "host_network": true,
  "audio": true,
  "usb": true,
  "udev": true,
  "ingress": true,
  "ingress_port": 8538,
  "panel_icon": "mdi:microphone-settings",
  "panel_title": "reSpeaker",
  "services": [
    "mqtt:want"
  ],
  "schema": {
    "name": "str",
    "listen_during_wake_sound": "bool",
    "max_volume_percent": "int(1,300)",
    "led_enabled": "bool",
    "button_enabled": "bool",
    "esphome_port": "port",
    "mqtt_enabled": "bool",
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "debug": "bool"
  },
  "options": {
    "name": "Linux Voice Assistant",
    "listen_during_wake_sound": true,
    "max_volume_percent": 100,
    "led_enabled": true,
    "button_enabled": true,
    "esphome_port": 6053,
    "mqtt_enabled": true,
    "debug": false
  }
}
